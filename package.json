{
  "name": "inkflow",
  "version": "1.0.0",
  "description": "INKFLOW - Premium Full-Stack Blogging Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
    "seed": "node seed.js",
    "build": "npm run build --prefix client"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rithik-1010/Inkflow.git"
  },
  "keywords": [
    "blogging",
    "platform",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "Rithik",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.3",
